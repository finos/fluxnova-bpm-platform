       ) ;
       rdf:type [ <BpmnDiagram> ] ?
    )
}

<BpmnDocumentation> CLOSED {
    (  $<BpmnDocumentation_tes> (  &<BpmnModelElementInstance_tes> ;
          rdf:type [ <BpmnModelElementInstance> ] ? ;
          <bpmn_id> @linkml:String ? ;
          <text_format> @linkml:String ? ;
          <text_content> @linkml:String ?
       ) ;
       rdf:type [ <BpmnDocumentation> ] ?
    )
}

<BpmnEdge> CLOSED {
    (  $<BpmnEdge_tes> (  &<DiLabeledEdge_tes> ;
          rdf:type [ <DiLabeledEdge> ] ? ;
          <bpmn_element> @linkml:String ? ;
          <source_element> @linkml:String ? ;
