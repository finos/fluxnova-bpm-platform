# metamodel_version: 1.12.0
# version: 3.1.1
BASE <https://w3id.org/lmodel/fluxnova-bpm-platform/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<BpmnActivationCondition> CLOSED {
    (  $<BpmnActivationCondition_tes> (  &<BpmnExpression_tes> ;
          rdf:type [ <BpmnExpression> ] ?
       ) ;
       rdf:type [ <BpmnActivationCondition> ] ?
    )
}

<BpmnActivity>  (
    @<BpmnCallActivity> OR @<BpmnSubProcess> OR @<BpmnTask>
)

<BpmnActivity_struct> {
    (  $<BpmnActivity_tes> (  &<BpmnFlowNode_tes> ;
          rdf:type [ <BpmnFlowNode> ] ? ;
          &<BpmnInteractionNode_tes> ;
          rdf:type [ <BpmnInteractionNode> ] ? ;
          <is_for_compensation> @linkml:Boolean ? ;
          <start_quantity> @linkml:Integer ? ;
          <completion_quantity> @linkml:Integer ? ;
          <default> @linkml:String ? ;
          <io_specification> @<BpmnIoSpecification> ? ;
          <properties> @<BpmnProperty> * ;
          <data_input_associations> @<BpmnDataInputAssociation> * ;
          <data_output_associations> @<BpmnDataOutputAssociation> * ;
          <resource_roles> @<BpmnResourceRole> * ;
          <loop_characteristics> @<BpmnLoopCharacteristics> ?
       ) ;
       rdf:type [ <BpmnActivity> ] ?
    )
}

<BpmnAdHocSubProcess> CLOSED {
    (  $<BpmnAdHocSubProcess_tes> (  &<BpmnSubProcess_tes> ;
          rdf:type [ <BpmnSubProcess> ] ? ;
          <ordering> @linkml:String ? ;
          <cancel_remaining_instances> @linkml:Boolean ? ;
          <completion_condition> @<BpmnCompletionCondition> ?
       ) ;
       rdf:type [ <BpmnAdHocSubProcess> ] ?
    )
}

<BpmnArtifact>  (
    @<BpmnAssociation> OR @<BpmnGroup> OR @<BpmnTextAnnotation>
)

<BpmnArtifact_struct> {
    (  $<BpmnArtifact_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ?
       ) ;
       rdf:type [ <BpmnArtifact> ] ?
    )
}

<BpmnAssignment> CLOSED {
    (  $<BpmnAssignment_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <from_expression> @<BpmnFrom> ;
          <to_expression> @<BpmnTo>
       ) ;
       rdf:type [ <BpmnAssignment> ] ?
    )
}

<BpmnAssociation> CLOSED {
    (  $<BpmnAssociation_tes> (  &<BpmnArtifact_tes> ;
          rdf:type [ <BpmnArtifact> ] ? ;
          <source_ref> @linkml:String ;
          <target_ref> @linkml:String ;
          <association_direction> [ <https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnAssociationDirection#None>
             <https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnAssociationDirection#One>
             <https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnAssociationDirection#Both> ] ?
       ) ;
       rdf:type [ <BpmnAssociation> ] ?
    )
}

<BpmnAuditing> CLOSED {
    (  $<BpmnAuditing_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ?
       ) ;
       rdf:type [ <BpmnAuditing> ] ?
    )
}

<BpmnBaseElement>  (
    @<BpmnArtifact> OR @<BpmnAssignment> OR @<BpmnAuditing> OR @<BpmnCategoryValue> OR @<BpmnComplexBehaviorDefinition> OR
    @<BpmnConversationAssociation> OR @<BpmnConversationLink> OR @<BpmnConversationNode> OR @<BpmnCorrelationKey> OR
    @<BpmnCorrelationPropertyBinding> OR @<BpmnCorrelationPropertyRetrievalExpression> OR @<BpmnCorrelationSubscription> OR
    @<BpmnDataAssociation> OR @<BpmnDataState> OR @<BpmnExpression> OR @<BpmnFlowElement> OR @<BpmnInputSet> OR @<BpmnIoBinding> OR
    @<BpmnIoSpecification> OR @<BpmnItemAwareElement> OR @<BpmnLane> OR @<BpmnLaneSet> OR @<BpmnLoopCharacteristics> OR
    @<BpmnMessageFlow> OR @<BpmnMessageFlowAssociation> OR @<BpmnMonitoring> OR @<BpmnOperation> OR @<BpmnOutputSet> OR
    @<BpmnParticipant> OR @<BpmnParticipantAssociation> OR @<BpmnParticipantMultiplicity> OR @<BpmnPartitionElement> OR
    @<BpmnRelationship> OR @<BpmnRendering> OR @<BpmnResourceAssignmentExpression> OR @<BpmnResourceParameter> OR
    @<BpmnResourceParameterBinding> OR @<BpmnResourceRole> OR @<BpmnRootElement>
)

<BpmnBaseElement_struct> {
    (  $<BpmnBaseElement_tes> (  &<BpmnModelElementInstance_tes> ;
          rdf:type [ <BpmnModelElementInstance> ] ? ;
          <bpmn_id> @linkml:String ? ;
          <bpmn_documentation> @<BpmnDocumentation> * ;
          <extension_elements> @<BpmnExtensionElements> ?
       ) ;
       rdf:type [ <BpmnBaseElement> ] ?
    )
}

<BpmnBoundaryEvent> CLOSED {
    (  $<BpmnBoundaryEvent_tes> (  &<BpmnCatchEvent_tes> ;
          rdf:type [ <BpmnCatchEvent> ] ? ;
          <cancel_activity> @linkml:Boolean ? ;
          <attached_to_ref> @linkml:String
       ) ;
       rdf:type [ <BpmnBoundaryEvent> ] ?
    )
}

<BpmnBusinessRuleTask> CLOSED {
    (  $<BpmnBusinessRuleTask_tes> (  &<BpmnTask_tes> ;
          rdf:type [ <BpmnTask> ] ? ;
          <implementation> @linkml:String ? ;
          <fluxnova_class> @linkml:String ? ;
          <fluxnova_delegate_expression> @linkml:String ? ;
          <fluxnova_expression> @linkml:String ? ;
          <fluxnova_result_variable> @linkml:String ? ;
          <fluxnova_topic> @linkml:String ? ;
          <fluxnova_type> @linkml:String ? ;
          <fluxnova_decision_ref> @linkml:String ? ;
          <fluxnova_decision_ref_binding> @linkml:String ? ;
          <fluxnova_decision_ref_version> @linkml:String ? ;
          <fluxnova_decision_ref_version_tag> @linkml:String ? ;
          <fluxnova_decision_ref_tenant_id> @linkml:String ? ;
          <fluxnova_map_decision_result> @linkml:String ? ;
          <fluxnova_task_priority> @linkml:String ?
       ) ;
       rdf:type [ <BpmnBusinessRuleTask> ] ?
    )
}

<BpmnCallableElement>  (
    CLOSED {
       (  $<BpmnCallableElement_tes> (  &<BpmnRootElement_tes> ;
             rdf:type [ <BpmnRootElement> ] ? ;
             <name> @linkml:String ? ;
             <supported_interface_refs> @linkml:String * ;
             <io_specification> @<BpmnIoSpecification> ? ;
             <io_bindings> @<BpmnIoBinding> *
          ) ;
          rdf:type [ <BpmnCallableElement> ] ?
       )
    } OR @<BpmnProcess>
)

<BpmnCallActivity> CLOSED {
    (  $<BpmnCallActivity_tes> (  &<BpmnActivity_tes> ;
          rdf:type [ <BpmnActivity> ] ? ;
          <called_element> @linkml:String ? ;
          <fluxnova_async> @linkml:Boolean ? ;
          <fluxnova_called_element_binding> @linkml:String ? ;
          <fluxnova_called_element_version> @linkml:String ? ;
          <fluxnova_called_element_version_tag> @linkml:String ? ;
          <fluxnova_case_ref> @linkml:String ? ;
          <fluxnova_case_binding> @linkml:String ? ;
          <fluxnova_case_version> @linkml:String ? ;
          <fluxnova_called_element_tenant_id> @linkml:String ? ;
          <fluxnova_case_tenant_id> @linkml:String ? ;
          <fluxnova_variable_mapping_class> @linkml:String ? ;
          <fluxnova_variable_mapping_delegate_expression> @linkml:String ?
       ) ;
       rdf:type [ <BpmnCallActivity> ] ?
    )
}

<BpmnCallConversation> CLOSED {
    (  $<BpmnCallConversation_tes> (  &<BpmnConversationNode_tes> ;
          rdf:type [ <BpmnConversationNode> ] ? ;
          <called_collaboration_ref> @linkml:String ? ;
          <participant_associations> @<BpmnParticipantAssociation> *
       ) ;
       rdf:type [ <BpmnCallConversation> ] ?
    )
}

<BpmnCancelEventDefinition> CLOSED {
    (  $<BpmnCancelEventDefinition_tes> (  &<BpmnEventDefinition_tes> ;
          rdf:type [ <BpmnEventDefinition> ] ?
       ) ;
       rdf:type [ <BpmnCancelEventDefinition> ] ?
    )
}

<BpmnCatchEvent>  (
    @<BpmnBoundaryEvent> OR @<BpmnIntermediateCatchEvent> OR @<BpmnStartEvent>
)

<BpmnCatchEvent_struct> {
    (  $<BpmnCatchEvent_tes> (  &<BpmnEvent_tes> ;
          rdf:type [ <BpmnEvent> ] ? ;
          <parallel_multiple> @linkml:Boolean ? ;
          <data_outputs> @<BpmnDataOutput> * ;
          <data_output_associations> @<BpmnDataOutputAssociation> * ;
          <output_set> @<BpmnOutputSet> ? ;
          <event_definitions> @<BpmnEventDefinition> * ;
          <event_definition_refs> @linkml:String *
       ) ;
       rdf:type [ <BpmnCatchEvent> ] ?
    )
}

<BpmnCategory> CLOSED {
    (  $<BpmnCategory_tes> (  &<BpmnRootElement_tes> ;
          rdf:type [ <BpmnRootElement> ] ? ;
          <name> @linkml:String ;
          <category_values> @<BpmnCategoryValue> *
       ) ;
       rdf:type [ <BpmnCategory> ] ?
    )
}

<BpmnCategoryValue> CLOSED {
    (  $<BpmnCategoryValue_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <value> @linkml:String ?
       ) ;
       rdf:type [ <BpmnCategoryValue> ] ?
    )
}

<BpmnChildLaneSet> CLOSED {
    (  $<BpmnChildLaneSet_tes> (  &<BpmnLaneSet_tes> ;
          rdf:type [ <BpmnLaneSet> ] ?
       ) ;
       rdf:type [ <BpmnChildLaneSet> ] ?
    )
}

<BpmnCollaboration>  (
    CLOSED {
       (  $<BpmnCollaboration_tes> (  &<BpmnRootElement_tes> ;
             rdf:type [ <BpmnRootElement> ] ? ;
             <name> @linkml:String ? ;
             <is_closed> @linkml:Boolean ? ;
             <participants> @<BpmnParticipant> * ;
             <message_flows> @<BpmnMessageFlow> * ;
             <artifacts> @<BpmnArtifact> * ;
             <conversation_nodes> @<BpmnConversationNode> * ;
             <conversation_associations> @<BpmnConversationAssociation> * ;
             <participant_associations> @<BpmnParticipantAssociation> * ;
             <message_flow_associations> @<BpmnMessageFlowAssociation> * ;
             <correlation_keys> @<BpmnCorrelationKey> * ;
             <conversation_links> @<BpmnConversationLink> *
          ) ;
          rdf:type [ <BpmnCollaboration> ] ?
       )
    } OR @<BpmnGlobalConversation>
)

<BpmnCompensateEventDefinition> CLOSED {
    (  $<BpmnCompensateEventDefinition_tes> (  &<BpmnEventDefinition_tes> ;
          rdf:type [ <BpmnEventDefinition> ] ? ;
          <wait_for_completion> @linkml:Boolean ? ;
          <activity_ref> @linkml:String ?
       ) ;
       rdf:type [ <BpmnCompensateEventDefinition> ] ?
    )
}

<BpmnCompletionCondition> CLOSED {
    (  $<BpmnCompletionCondition_tes> (  &<BpmnExpression_tes> ;
          rdf:type [ <BpmnExpression> ] ?
       ) ;
       rdf:type [ <BpmnCompletionCondition> ] ?
    )
}

<BpmnComplexBehaviorDefinition> CLOSED {
    (  $<BpmnComplexBehaviorDefinition_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ?
       ) ;
       rdf:type [ <BpmnComplexBehaviorDefinition> ] ?
    )
}

<BpmnComplexGateway> CLOSED {
    (  $<BpmnComplexGateway_tes> (  &<BpmnGateway_tes> ;
          rdf:type [ <BpmnGateway> ] ? ;
          <default> @linkml:String ? ;
          <activation_condition> @<BpmnActivationCondition> ?
       ) ;
       rdf:type [ <BpmnComplexGateway> ] ?
    )
}

<BpmnCondition> CLOSED {
    (  $<BpmnCondition_tes> (  &<BpmnExpression_tes> ;
          rdf:type [ <BpmnExpression> ] ?
       ) ;
       rdf:type [ <BpmnCondition> ] ?
    )
}

<BpmnConditionalEventDefinition> CLOSED {
    (  $<BpmnConditionalEventDefinition_tes> (  &<BpmnEventDefinition_tes> ;
          rdf:type [ <BpmnEventDefinition> ] ? ;
          <fluxnova_variable_name> @linkml:String ? ;
          <fluxnova_variable_events> @linkml:String ? ;
          <condition> @<BpmnCondition>
       ) ;
       rdf:type [ <BpmnConditionalEventDefinition> ] ?
    )
}

<BpmnConditionExpression> CLOSED {
    (  $<BpmnConditionExpression_tes> (  &<BpmnFormalExpression_tes> ;
          rdf:type [ <BpmnFormalExpression> ] ? ;
          <xsi_type> @linkml:String ? ;
          <fluxnova_resource> @linkml:String ?
       ) ;
       rdf:type [ <BpmnConditionExpression> ] ?
    )
}

<BpmnConversation> CLOSED {
    (  $<BpmnConversation_tes> (  &<BpmnConversationNode_tes> ;
          rdf:type [ <BpmnConversationNode> ] ?
       ) ;
       rdf:type [ <BpmnConversation> ] ?
    )
}

<BpmnConversationAssociation> CLOSED {
    (  $<BpmnConversationAssociation_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <inner_conversation_node_ref> @linkml:String ;
          <outer_conversation_node_ref> @linkml:String
       ) ;
       rdf:type [ <BpmnConversationAssociation> ] ?
    )
}

<BpmnConversationLink> CLOSED {
    (  $<BpmnConversationLink_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <name> @linkml:String ? ;
          <source_ref> @linkml:String ;
          <target_ref> @linkml:String
       ) ;
       rdf:type [ <BpmnConversationLink> ] ?
    )
}

<BpmnConversationNode>  (
    @<BpmnCallConversation> OR @<BpmnConversation> OR @<BpmnSubConversation>
)

<BpmnConversationNode_struct> {
    (  $<BpmnConversationNode_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          &<BpmnInteractionNode_tes> ;
          rdf:type [ <BpmnInteractionNode> ] ? ;
          <name> @linkml:String ? ;
          <participant_refs> @linkml:String * ;
          <message_flow_refs> @linkml:String * ;
          <correlation_keys> @<BpmnCorrelationKey> *
       ) ;
       rdf:type [ <BpmnConversationNode> ] ?
    )
}

<BpmnCorrelationKey> CLOSED {
    (  $<BpmnCorrelationKey_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <name> @linkml:String ? ;
          <correlation_property_refs> @linkml:String *
       ) ;
       rdf:type [ <BpmnCorrelationKey> ] ?
    )
}

<BpmnCorrelationProperty> CLOSED {
    (  $<BpmnCorrelationProperty_tes> (  &<BpmnRootElement_tes> ;
          rdf:type [ <BpmnRootElement> ] ? ;
          <name> @linkml:String ? ;
          <type> @linkml:String ? ;
          <correlation_property_retrieval_expressions> @<BpmnCorrelationPropertyRetrievalExpression> +
       ) ;
       rdf:type [ <BpmnCorrelationProperty> ] ?
    )
}

<BpmnCorrelationPropertyBinding> CLOSED {
    (  $<BpmnCorrelationPropertyBinding_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <correlation_property_ref> @linkml:String ;
          <data_path> @<BpmnDataPath>
       ) ;
       rdf:type [ <BpmnCorrelationPropertyBinding> ] ?
    )
}

<BpmnCorrelationPropertyRetrievalExpression> CLOSED {
    (  $<BpmnCorrelationPropertyRetrievalExpression_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <message_ref> @linkml:String ;
          <message_path> @<BpmnMessagePath>
       ) ;
       rdf:type [ <BpmnCorrelationPropertyRetrievalExpression> ] ?
    )
}

<BpmnCorrelationSubscription> CLOSED {
    (  $<BpmnCorrelationSubscription_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <correlation_key_ref> @linkml:String ;
          <correlation_property_bindings> @<BpmnCorrelationPropertyBinding> *
       ) ;
       rdf:type [ <BpmnCorrelationSubscription> ] ?
    )
}

<BpmnDataAssociation>  (
    CLOSED {
       (  $<BpmnDataAssociation_tes> (  &<BpmnBaseElement_tes> ;
             rdf:type [ <BpmnBaseElement> ] ? ;
             <source_refs> @linkml:String * ;
             <target_ref> @linkml:String ;
             <transformation> @<BpmnTransformation> ? ;
             <assignments> @<BpmnAssignment> *
          ) ;
          rdf:type [ <BpmnDataAssociation> ] ?
       )
    } OR @<BpmnDataInputAssociation> OR @<BpmnDataOutputAssociation>
)

<BpmnDataInput>  (
    CLOSED {
       (  $<BpmnDataInput_tes> (  &<BpmnItemAwareElement_tes> ;
             rdf:type [ <BpmnItemAwareElement> ] ? ;
             <name> @linkml:String ? ;
             <is_collection> @linkml:Boolean ?
          ) ;
          rdf:type [ <BpmnDataInput> ] ?
       )
    } OR @<BpmnInputDataItem>
)

<BpmnDataInputAssociation> CLOSED {
    (  $<BpmnDataInputAssociation_tes> (  &<BpmnDataAssociation_tes> ;
          rdf:type [ <BpmnDataAssociation> ] ?
       ) ;
       rdf:type [ <BpmnDataInputAssociation> ] ?
    )
}

<BpmnDataObject> CLOSED {
    (  $<BpmnDataObject_tes> (  &<BpmnFlowElement_tes> ;
          rdf:type [ <BpmnFlowElement> ] ? ;
          <item_subject_ref> @linkml:String ? ;
          <is_collection> @linkml:Boolean ? ;
          <data_state> @<BpmnDataState> ?
       ) ;
       rdf:type [ <BpmnDataObject> ] ?
    )
}

<BpmnDataObjectReference> CLOSED {
    (  $<BpmnDataObjectReference_tes> (  &<BpmnFlowElement_tes> ;
          rdf:type [ <BpmnFlowElement> ] ? ;
          <item_subject_ref> @linkml:String ? ;
          <data_object_ref> @linkml:String ? ;
          <data_state> @<BpmnDataState> ?
       ) ;
       rdf:type [ <BpmnDataObjectReference> ] ?
    )
}

<BpmnDataOutput>  (
    CLOSED {
       (  $<BpmnDataOutput_tes> (  &<BpmnItemAwareElement_tes> ;
             rdf:type [ <BpmnItemAwareElement> ] ? ;
             <name> @linkml:String ? ;
             <is_collection> @linkml:Boolean ?
          ) ;
          rdf:type [ <BpmnDataOutput> ] ?
       )
    } OR @<BpmnOutputDataItem>
)

<BpmnDataOutputAssociation> CLOSED {
    (  $<BpmnDataOutputAssociation_tes> (  &<BpmnDataAssociation_tes> ;
          rdf:type [ <BpmnDataAssociation> ] ?
       ) ;
       rdf:type [ <BpmnDataOutputAssociation> ] ?
    )
}

<BpmnDataPath> CLOSED {
    (  $<BpmnDataPath_tes> (  &<BpmnFormalExpression_tes> ;
          rdf:type [ <BpmnFormalExpression> ] ?
       ) ;
       rdf:type [ <BpmnDataPath> ] ?
    )
}

<BpmnDataState> CLOSED {
    (  $<BpmnDataState_tes> (  &<BpmnBaseElement_tes> ;
          rdf:type [ <BpmnBaseElement> ] ? ;
          <name> @linkml:String ?
       ) ;
       rdf:type [ <BpmnDataState> ] ?
    )
}

<BpmnDataStore> CLOSED {
    (  $<BpmnDataStore_tes> (  &<BpmnRootElement_tes> ;
          rdf:type [ <BpmnRootElement> ] ? ;
          <name> @linkml:String ? ;
          <capacity> @linkml:Integer ? ;
          <is_unlimited> @linkml:Boolean ? ;
          <item_subject_ref> @linkml:String ? ;
          <data_state> @<BpmnDataState> ?
       ) ;
       rdf:type [ <BpmnDataStore> ] ?
    )
}

<BpmnDataStoreReference> CLOSED {
    (  $<BpmnDataStoreReference_tes> (  &<BpmnFlowElement_tes> ;
          rdf:type [ <BpmnFlowElement> ] ? ;
          <item_subject_ref> @linkml:String ? ;
          <data_store_ref> @linkml:String ? ;
          <data_state> @<BpmnDataState> ?
       ) ;
       rdf:type [ <BpmnDataStoreReference> ] ?
    )
}

<BpmnDefinitions> CLOSED {
    (  $<BpmnDefinitions_tes> (  &<BpmnModelElementInstance_tes> ;
          rdf:type [ <BpmnModelElementInstance> ] ? ;
          <bpmn_id> @linkml:String ? ;
          <name> @linkml:String ? ;
          <target_namespace> @linkml:String ;
          <expression_language> @linkml:String ? ;
          <type_language> @linkml:String ? ;
          <exporter> @linkml:String ? ;
          <exporter_version> @linkml:String ? ;
          <imports> @<BpmnImport> * ;
          <extensions> @<BpmnExtension> * ;
          <root_elements> @<BpmnRootElement> * ;
          <bpmn_diagrams> @<BpmnDiagram> * ;
          <relationships> @<BpmnRelationship> *
       ) ;
       rdf:type [ <BpmnDefinitions> ] ?
    )
}

<BpmnDiagram> CLOSED {
    (  $<BpmnDiagram_tes> (  &<DiDiagram_tes> ;
