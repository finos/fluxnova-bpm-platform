{
  "name": "fluxnova_bpm_platform",
  "description": "The tables Fluxnova's process engine keeps, and the BPMN elements its model API reads, as of Fluxnova 3.1.1.",
  "title": "Fluxnova BPM Platform",
  "source": "https://github.com/finos/fluxnova-bpm-platform/tree/3ac64ca2c3d7c93f00395e18b9dc3218e5250264/engine/src/main/resources/org/finos/fluxnova/bpm/engine/db/create",
  "see_also": [
    "https://lmodel.github.io/fluxnova-bpm-platform"
  ],
  "id": "https://w3id.org/lmodel/fluxnova-bpm-platform",
  "version": "3.1.1",
  "imports": [
    "linkml:types",
    "fluxnova_bpm_engine",
    "fluxnova_bpmn_extension",
    "fluxnova_bpmn_semantic",
    "fluxnova_bpmn_bpmndi",
    "fluxnova_bpmn_di",
    "fluxnova_bpmn_dc",
    "fluxnova_bpmn_core"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "fluxnova_bpm_platform",
      "prefix_reference": "https://w3id.org/lmodel/fluxnova-bpm-platform/"
    },
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    }
  ],
  "default_prefix": "fluxnova_bpm_platform",
  "default_range": "string",
  "subsets": [
    {
      "name": "engine_base",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineBase",
      "description": "The general tables: stored bytes, properties, the schema log and the metrics logs.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_repository",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineRepository",
      "description": "The repository tables: deployments and the process, case, decision and form definitions in them.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_runtime",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineRuntime",
      "description": "The runtime tables: executions, tasks, variables, event subscriptions, incidents and external tasks.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_job",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineJob",
      "description": "The job tables: jobs, their definitions and batches.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_identity",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineIdentity",
      "description": "The identity tables: users, groups, tenants, their memberships and authorizations.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_history",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineHistory",
      "description": "The history tables: what process, case and decision instances did, kept after they end.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "engine_collaboration",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/EngineCollaboration",
      "description": "The tables of what people add to tasks and process instances: comments, attachments and filters.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "@type": "SubsetDefinition"
    },
    {
      "name": "bpmn_dc",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnDc",
      "description": "Diagram Common: the bounds, points and fonts diagrams use.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "bpmn_di",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnDi",
      "description": "Diagram Interchange: the generic diagrams, shapes and edges.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "bpmn_bpmndi",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnBpmndi",
      "description": "BPMN Diagram Interchange: how a BPMN diagram lays its elements out.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "bpmn_semantic",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnSemantic",
      "description": "The BPMN 2.0 elements of a process, collaboration or definitions document.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "bpmn_extension",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnExtension",
      "description": "Fluxnova's extension elements, which sit in a BPMN element's extensionElements.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_core",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "HistoricProcessInstanceState",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/HistoricProcessInstanceState",
      "description": "The state a historic process instance records.",
      "comments": [
        "Values from engine/history/HistoricProcessInstance.java."
      ],
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "permissible_values": [
        {
          "text": "ACTIVE",
          "description": "The process instance is running."
        },
        {
          "text": "SUSPENDED",
          "description": "The process instance is suspended."
        },
        {
          "text": "COMPLETED",
          "description": "The process instance reached an end event."
        },
        {
          "text": "EXTERNALLY_TERMINATED",
          "description": "The process instance was ended from outside, such as through the REST API."
        },
        {
          "text": "INTERNALLY_TERMINATED",
          "description": "The process instance was ended from within, such as by a terminate end event."
        }
      ]
    },
    {
      "name": "HistoricVariableInstanceState",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/HistoricVariableInstanceState",
      "description": "Whether a historic variable instance still exists.",
      "comments": [
        "Values from engine/history/HistoricVariableInstance.java."
      ],
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "permissible_values": [
        {
          "text": "CREATED",
          "description": "The variable exists."
        },
        {
          "text": "DELETED",
          "description": "The variable was deleted."
        }
      ]
    },
    {
      "name": "ConfigurationStatus",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/ConfigurationStatus",
      "description": "Whether a configuration entry is in effect.",
      "comments": [
        "Values from engine/configuration/Configuration.java."
      ],
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "permissible_values": [
        {
          "text": "ACTIVE",
          "description": "The entry is in effect."
        },
        {
          "text": "INACTIVE",
          "description": "A newer version of the entry replaced it."
        },
        {
          "text": "DELETED",
          "description": "The entry was deleted, and is kept."
        }
      ]
    },
    {
      "name": "DelegationState",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/DelegationState",
      "description": "Where a delegated task stands.",
      "comments": [
        "Values from engine/task/DelegationState.java."
      ],
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpm_engine",
      "permissible_values": [
        {
          "text": "PENDING",
          "description": "The task was delegated and waits for the delegate to resolve it."
        },
        {
          "text": "RESOLVED",
          "description": "The delegate resolved the task and handed it back to its owner."
        }
      ]
    },
    {
      "name": "BpmnAssociationDirection",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnAssociationDirection",
      "description": "Which ends of an association an arrow is drawn at.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "None",
          "description": "No arrow is drawn."
        },
        {
          "text": "One",
          "description": "An arrow points at the target."
        },
        {
          "text": "Both",
          "description": "Arrows point at both ends."
        }
      ]
    },
    {
      "name": "BpmnEventBasedGatewayType",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnEventBasedGatewayType",
      "description": "How an event-based gateway that starts a process waits for its events.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "Exclusive",
          "description": "The first event starts the instance, and the others are no longer waited for."
        },
        {
          "text": "Parallel",
          "description": "Each event starts an instance, or joins the one already started."
        }
      ]
    },
    {
      "name": "BpmnGatewayDirection",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnGatewayDirection",
      "description": "Whether a gateway splits flows, joins them or does both.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "Unspecified",
          "description": "The model does not say."
        },
        {
          "text": "Converging",
          "description": "The gateway joins incoming flows into one."
        },
        {
          "text": "Diverging",
          "description": "The gateway splits one flow into several."
        },
        {
          "text": "Mixed",
          "description": "The gateway both joins and splits."
        }
      ]
    },
    {
      "name": "BpmnItemKind",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnItemKind",
      "description": "Whether an item is information or a physical thing.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "Information",
          "description": "The item is information."
        },
        {
          "text": "Physical",
          "description": "The item is a physical thing."
        }
      ]
    },
    {
      "name": "BpmnMultiInstanceFlowCondition",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnMultiInstanceFlowCondition",
      "description": "When a multi-instance activity throws an event as its instances complete.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "None",
          "description": "An event is thrown for each instance that completes."
        },
        {
          "text": "One",
          "description": "An event is thrown when the first instance completes."
        },
        {
          "text": "All",
          "description": "No event is thrown."
        },
        {
          "text": "Complex",
          "description": "The complex behavior definitions decide which events are thrown."
        }
      ]
    },
    {
      "name": "BpmnProcessType",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnProcessType",
      "description": "Whether a process is private to its participant, public, or neither.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "None",
          "description": "The model does not say."
        },
        {
          "text": "Public",
          "description": "The process shows only what its participant exchanges with others."
        },
        {
          "text": "Private",
          "description": "The process is internal to its participant."
        }
      ]
    },
    {
      "name": "BpmnRelationshipDirection",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnRelationshipDirection",
      "description": "Which way a relationship points.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "None",
          "description": "It has no direction."
        },
        {
          "text": "Forward",
          "description": "From its sources to its targets."
        },
        {
          "text": "Backward",
          "description": "From its targets to its sources."
        },
        {
          "text": "Both",
          "description": "Both ways."
        }
      ]
    },
    {
      "name": "BpmnTransactionMethod",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnTransactionMethod",
      "description": "How a transaction commits or cancels, by the three values BPMN keeps from BPMN 1.1.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_semantic",
      "permissible_values": [
        {
          "text": "##Compensate",
          "description": "The transaction is cancelled by compensation; the default.",
          "title": "Compensate"
        },
        {
          "text": "##Image",
          "description": "The method BPMN 1.1 called image.",
          "title": "Image"
        },
        {
          "text": "##Store",
          "description": "The method BPMN 1.1 called store.",
          "title": "Store"
        }
      ]
    },
    {
      "name": "BpmnMessageVisibleKind",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnMessageVisibleKind",
      "description": "Whether the message on a message flow is drawn as the one that starts the exchange.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_bpmndi",
      "permissible_values": [
        {
          "text": "initiating",
          "description": "The message starts the exchange."
        },
        {
          "text": "non_initiating",
          "description": "The message answers one that started the exchange."
        }
      ]
    },
    {
      "name": "BpmnParticipantBandKind",
      "definition_uri": "https://w3id.org/lmodel/fluxnova-bpm-platform/BpmnParticipantBandKind",
      "description": "Where a participant band sits on a choreography activity, and whether its participant initiates.",
      "from_schema": "https://w3id.org/lmodel/fluxnova-bpm-platform/fluxnova_bpmn_bpmndi",
      "permissible_values": [
        {
          "text": "top_initiating",
          "description": "The top band, of the initiating participant."
        },
        {
          "text": "middle_initiating",
          "description": "A middle band, of the initiating participant."
        },
        {
          "text": "bottom_initiating",
          "description": "The bottom band, of the initiating participant."
        },
        {
          "text": "top_non_initiating",
          "description": "The top band, of a participant that does not initiate."
        },
        {
          "text": "middle_non_initiating",
          "description": "A middle band, of a participant that does not initiate."
        },
        {
          "text": "bottom_non_initiating",
          "description": "The bottom band, of a participant that does not initiate."
        }
      ]
    }
  ],
