<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="fluxnovaComprehensiveTest" isExecutable="true" fluxnova:historyTimeToLive="180">

    <startEvent id="theStart" />

    <sequenceFlow id="flow1" sourceRef="theStart" targetRef="javaServiceClass" />
    <serviceTask id="javaServiceClass"
                 name="Java service invocation with fluxnova namespace"
                 fluxnova:asyncBefore="true"
                 fluxnova:class="org.finos.fluxnova.bpm.engine.test.bpmn.servicetask.util.ToUppercase" />

    <sequenceFlow id="flow2" sourceRef="javaServiceClass" targetRef="javaServiceDelegateExpression" />
    <serviceTask id="javaServiceDelegateExpression"
                 name="Java service with fluxnova delegateExpression"
                 fluxnova:delegateExpression="${toUppercaseBean}" />

    <sequenceFlow id="flow3" sourceRef="javaServiceDelegateExpression" targetRef="javaServiceExpression" />
    <serviceTask id="javaServiceExpression"
                 name="Java service with fluxnova expression"
                 fluxnova:expression="${execution.setVariable('myVar', 'test')}" />

    <sequenceFlow id="flow4" sourceRef="javaServiceExpression" targetRef="externalService" />
    <serviceTask id="externalService"
                 name="External service with fluxnova type"
                 fluxnova:type="external"
                 fluxnova:topic="testTopic" />

    <sequenceFlow id="flow5" sourceRef="externalService" targetRef="theEnd" />

    <endEvent id="theEnd" />

  </process>

</definitions>