<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="userTaskFluxnovaNamespacePrecedence" isExecutable="true">

    <startEvent id="theStart" />

    <sequenceFlow id="flow1" sourceRef="theStart" targetRef="UserTask" />

    <userTask id="UserTask"
              name="userTask"
              fluxnova:formRef="fluxnovaFormId"
              camunda:formRef="camundaFormId"
              fluxnova:formRefBinding="version"
              camunda:formRefBinding="latest"
              fluxnova:formRefVersion="7"
              camunda:formRefVersion="1" />

    <sequenceFlow id="flow2" sourceRef="UserTask" targetRef="theEnd" />

    <endEvent id="theEnd" />

  </process>

</definitions>