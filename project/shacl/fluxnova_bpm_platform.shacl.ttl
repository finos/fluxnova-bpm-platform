<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiAgent> a sh:NodeShape ;
    rdfs:comment """Autonomous or semi-autonomous AI agent that acts as an Agent in a Fluxnova
workflow. Concrete embodiment of one or more AI models exposed through a
provider endpoint. Distinct from the human, organizational, or system Agent
kinds declared in the base provenance module.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Email address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/identity/email> ],
        [ sh:datatype xsd:string ;
            sh:description """Provider or vendor that hosts the model endpoint (e.g. "openai", "anthropic",
"azure-openai", "vertex-ai", "self-hosted-vllm").""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/provider> ],
        [ sh:description "Modalities the model produces as output." ;
            sh:in ( "TEXT" "IMAGE" "AUDIO" "VIDEO" "MULTIMODAL" "EMBEDDING" ) ;
            sh:order 8 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/output_modalities> ],
        [ sh:datatype xsd:string ;
            sh:description "API or service endpoint URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/endpoint> ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:integer ;
            sh:description "Maximum input context window in tokens." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/context_window_tokens> ],
        [ sh:datatype xsd:string ;
            sh:description """External CURIE or URI reference to a larger AI system this agent belongs
to (typically modeled in an AI governance vocabulary such as nexus:AiSystem
or airo:AISystem). String reference rather than typed slot so the AI
provenance overlay does not pull in a governance ontology.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/is_part_of_ai_system> ],
        [ sh:datatype xsd:string ;
            sh:description "Roles played by the agent in this context." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/role> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of model parameters (where disclosed)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/parameter_count> ],
        [ sh:datatype xsd:string ;
            sh:description "Released or pinned version identifier for the model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:softwareVersion ],
        [ sh:datatype xsd:string ;
            sh:description "Concrete model name (e.g. \"gpt-4o-2024-05-13\", \"claude-3-5-sonnet-20240620\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:description "Kind of agent (person, organization, system, service account)." ;
            sh:in ( prov:Person prov:Organization prov:SoftwareAgent prov:SoftwareAgent ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/agent_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:name ],
        [ sh:description "Modalities the model accepts as input." ;
            sh:in ( "TEXT" "IMAGE" "AUDIO" "VIDEO" "MULTIMODAL" "EMBEDDING" ) ;
            sh:order 7 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/input_modalities> ],
        [ sh:datatype xsd:string ;
            sh:description "Model family or product line (e.g. \"GPT-4\", \"Claude 3\", \"Llama 3\", \"Mistral 7B\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:productID ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiAgent> .

<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiToolDefinition> a sh:NodeShape ;
    rdfs:comment """Prospective definition of a tool advertised to an AI agent. Corresponds to
a child activity of an ad-hoc agent subprocess that is exposed to the model
as a callable function. Captures the tool description and the process
variables the tool reads and writes, and links to the backing step
definition. Distinct from ToolCall, which records a concrete invocation of
such a tool during a run.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Process variables the tool writes as output." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/writes_variables> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepDefinition> ;
            sh:description """Step definition (typically a child service task of the ad-hoc agent
subprocess) that implements the tool.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/backing_step_definition> ],
        [ sh:datatype xsd:string ;
            sh:description "Human- or model-facing description of what the tool does." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_description> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Process variables the tool reads as input." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/reads_variables> ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:url ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiToolDefinition> .

<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/PromptMessage> a sh:NodeShape ;
    rdfs:comment """A single message turn in an AI model invocation (system, user, assistant,
or tool turn). Records the role, the (possibly redacted) content, an
ordering index inside the invocation, and a data classification.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:name ],
        [ sh:description "Data classification of the value (public, internal, confidential, restricted)." ;
            sh:in ( "PUBLIC" "INTERNAL" "CONFIDENTIAL" "RESTRICTED" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/classification> ],
        [ sh:datatype xsd:integer ;
            sh:description "Exporter-assigned ordering number for deterministic serialization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/sequence_no> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:identifier ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> ;
            sh:description "AI model invocation that produced or owns this message or tool call." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/parent_invocation> ],
        [ sh:datatype xsd:string ;
            sh:description """Hash of the message content (algorithm-prefixed, e.g. "sha256:...").
Used to deduplicate or to attest to a message that has been redacted.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/content_hash> ],
        [ sh:description "Conversational role of the message (system, user, assistant, tool)." ;
            sh:in ( "SYSTEM" "USER" "ASSISTANT" "TOOL" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/message_role> ],
        [ sh:datatype xsd:string ;
            sh:description "Message content (may be redacted in export)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/content> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the serialized value has been redacted for export." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/redacted> ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/PromptMessage> .

