            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_call_id> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution ended (absent for running instances)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:endTime ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiToolDefinition> ;
            sh:description "Prospective tool definition that this call is an invocation of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_definition> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> ;
            sh:description "AI model invocation that produced or owns this message or tool call." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/parent_invocation> ],
        [ sh:datatype xsd:string ;
            sh:description "Tool or function name as exposed to the model." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_name> ],
        [ sh:datatype xsd:string ;
            sh:description "JSON-serialized result returned by the tool." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/result_json> ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:url ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ToolCall> .

