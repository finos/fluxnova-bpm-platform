<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AgentLoopRun> a sh:NodeShape ;
    rdfs:comment """One run of an autonomous AI agent loop hosted by an (ad-hoc) subprocess.
Owns the ordered sequence of AiModelInvocation turns performed during the
loop, together with the tools advertised to the model. Each turn is a
single model call; tool calls made in a turn may materialize child step
runs. Inherits status, timestamps, parent workflow run, sequence number,
and incident linkage from StepRun.

Use this as the parent record for an agentic subprocess: the loop is a
single StepDefinition of bpmn_type AD_HOC_SUB_PROCESS and
implementation_kind AGENT_LOOP, and each individual model call is a child
AiModelInvocation with a turn_index.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> ;
            sh:description "Ordered sequence of model invocation turns performed during an agent loop." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/model_invocations> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiToolDefinition> ;
            sh:description "Tools advertised to the model for the duration of the agent loop." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/available_tools> ],
        [ sh:description "Status of the workflow run or step run." ;
            sh:in ( schema1:PotentialActionStatus schema1:ActiveActionStatus schema1:CompletedActionStatus schema1:FailedActionStatus "CANCELLED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path schema1:actionStatus ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path schema1:identifier ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ParameterValue> ;
            sh:description "Observed input parameter values at the workflow or step boundary (by-reference; declare full values under ProvenanceBundle.parameter_values)." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path schema1:object ],
        [ sh:datatype xsd:string ;
            sh:description "Incident message." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/incident_message> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowArtifact> ;
            sh:description "Artifacts produced by the step run (by-reference; declare full artifacts under ProvenanceBundle.artifacts)." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:string ;
            sh:description "Runtime activity instance identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/activity_instance_id> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiAgent> ;
            sh:description "AI agent that was invoked to produce the step result." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ExecutionResource> ;
            sh:description "Resource (pod, container, node, queue) used to execute the step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/execution_resource> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/Environment> ;
            sh:description "Runtime environment in which the run took place." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/environment> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowArtifact> ;
            sh:description "Artifacts consumed by the step run (by-reference; declare full artifacts under ProvenanceBundle.artifacts)." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path schema1:url ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/Agent> ;
            sh:description "Agent (assignee, service account, system) that executed the step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowRun> ;
            sh:description "Parent workflow run for the step run." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/workflow_run> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step runs whose completion preceded and informed this step run (by-reference)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:integer ;
            sh:description "Exporter-assigned ordering number for deterministic serialization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/sequence_no> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of retries this job has left. Whenever the jobexecutor fails to execute the job, this value is decremented. When it hits zero, the job is supposed to be dead and not retried again (ie a manu..." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/retries> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ParameterValue> ;
            sh:description "Observed output parameter values at the workflow or step boundary (by-reference; declare full values under ProvenanceBundle.parameter_values)." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:result ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution ended (absent for running instances)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:endTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:startTime ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Parent step run for nested step executions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/parent_step_run> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepDefinition> ;
            sh:description "Step definition this run instantiates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:instrument ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AgentLoopRun> .

<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiDataset> a sh:NodeShape ;
    rdfs:comment """Dataset artifact associated with an AI model invocation, an evaluation,
a training run, or a fine-tuning step. Extends the generic WorkflowArtifact
class with AI-specific metadata such as dataset kind, record count, license,
and data classification.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Content hash or checksum string (algorithm-prefixed, e.g. \"sha256:...\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/hash> ],
        [ sh:datatype xsd:string ;
            sh:description "File path or URI locating the artifact content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:contentUrl ],
        [ sh:description "Classifier for the kind of artifact (BPMN XML, payload, document, log, etc.)." ;
            sh:in ( "BPMN_XML" "DMN_XML" "FORM_SCHEMA" "PAYLOAD" "DOCUMENT" "LOG" "EXPORT_BUNDLE" "SCREENSHOT" "OTHER" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/artifact_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "URI of the dataset license (e.g. SPDX license URL)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:license ],
        [ sh:description "Role of the dataset (training, fine-tuning, evaluation, RAG corpus, ground truth)." ;
            sh:in ( "TRAINING" "FINE_TUNING" "EVALUATION" "RAG_CORPUS" "GROUND_TRUTH" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/dataset_kind> ],
        [ sh:datatype xsd:integer ;
            sh:description "Size of the artifact content in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:contentSize ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step run that produced this artifact or parameter value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of records in the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/record_count> ],
        [ sh:description "Data classification of the value (public, internal, confidential, restricted)." ;
            sh:in ( "PUBLIC" "INTERNAL" "CONFIDENTIAL" "RESTRICTED" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/classification> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step runs that consumed this artifact or parameter value (by-reference)." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "IANA media type / MIME type of the artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:encodingFormat ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:name ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiDataset> .

<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/EvaluationResult> a sh:NodeShape ;
    rdfs:comment """Result of a quality or safety evaluation against an AI model invocation.
Supports human review, LLM-as-judge, deterministic metrics, guardrails,
and static rule checks. Distinct from offline benchmark scoring such as
nexus:AiEvalResult (a related but coarser concept).""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Metric name (e.g. duration_ms, queue_wait_ms, cpu_seconds, tokens_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/metric_name> ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the evaluator (rubric name, judge model name, metric name)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluator_name> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the evaluation was considered passing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/passing> ],
        [ sh:datatype xsd:decimal ;
            sh:description "Metric numeric value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/metric_value> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when the evaluation was performed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluated_at> ],
        [ sh:description "Kind of evaluator (human, LLM-as-judge, metric, guardrail, static rule)." ;
            sh:in ( "HUMAN_REVIEW" "LLM_AS_JUDGE" "METRIC" "GUARDRAIL" "STATIC_RULE" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluator_kind> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> ;
            sh:description "AI model invocation that was evaluated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluated_invocation> ],
        [ sh:datatype xsd:string ;
