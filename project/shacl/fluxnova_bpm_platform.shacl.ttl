        [ sh:datatype xsd:string ;
            sh:description "JSON-serialized arguments passed to the tool." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/arguments_json> ],
        [ sh:datatype xsd:string ;
