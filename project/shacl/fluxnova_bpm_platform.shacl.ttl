<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ModelArtifact> a sh:NodeShape ;
    rdfs:comment """Persistent model artifact such as a checkpoint, weights file, or model
card publication. Distinct from AiModelDescriptor: this is a concrete
file or URI, while AiModelDescriptor is the runtime component used
during invocation.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Size of the artifact content in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:contentSize ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:identifier ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step run that produced this artifact or parameter value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Content hash or checksum string (algorithm-prefixed, e.g. \"sha256:...\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/hash> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ModelArtifact> ;
            sh:description "Upstream base model artifact this artifact derives from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step runs that consumed this artifact or parameter value (by-reference)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:used ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiDataset> ;
            sh:description "Datasets used to train or fine-tune the model." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/training_datasets> ],
        [ sh:datatype xsd:string ;
            sh:description "URI of the model card or model documentation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/model_card_uri> ],
        [ sh:description "Classifier for the kind of artifact (BPMN XML, payload, document, log, etc.)." ;
            sh:in ( "BPMN_XML" "DMN_XML" "FORM_SCHEMA" "PAYLOAD" "DOCUMENT" "LOG" "EXPORT_BUNDLE" "SCREENSHOT" "OTHER" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/artifact_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "URI of the model weights or checkpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/weights_uri> ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of model parameters (where disclosed)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/parameter_count> ],
        [ sh:datatype xsd:string ;
            sh:description "File path or URI locating the artifact content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:contentUrl ],
        [ sh:datatype xsd:string ;
            sh:description "IANA media type / MIME type of the artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:encodingFormat ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ModelArtifact> .

<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ToolCall> a sh:NodeShape ;
    rdfs:comment """A single tool / function call made by an AI agent during an invocation.
Captures the tool name, the provider-assigned call identifier, the
arguments passed, the result returned, the status of the call, and an
optional link to the step run that materialized the call.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:startTime ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step run that was materialized to execute the tool call, if any." ;
