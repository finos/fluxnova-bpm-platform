            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/follow_up_date> ],
        [ sh:datatype xsd:string ;
