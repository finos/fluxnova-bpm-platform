<https://w3id.org/lmodel/fluxnova-bpm-platform/base/TaskMeterLog> a sh:NodeShape ;
    rdfs:comment "Task Meter Log entity in the engine infrastructure." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "Hash of the assignee for aggregation." ;
            sh:maxCount 1 ;
