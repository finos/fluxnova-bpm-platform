<https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> a sh:NodeShape ;
    rdfs:comment """One concrete invocation of an AI model from a workflow step. Captures the
runtime call (kind, parameters, prompts, tool calls, response), the
consumption telemetry (token counts, cost), any safety flags raised, and
any evaluation results attached. Inherits status, timestamps, parent
workflow run, sequence number, and incident linkage from StepRun.

A single stand-alone call sets invocation_kind to CHAT_COMPLETION,
TOOL_USE, etc. When it is one turn of an agentic loop it links back to its
AgentLoopRun via parent_agent_loop and carries a turn_index.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ExecutionResource> ;
            sh:description "Resource (pod, container, node, queue) used to execute the step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/execution_resource> ],
        [ sh:datatype xsd:integer ;
            sh:description "Total prompt / input tokens consumed by the invocation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/total_input_tokens> ],
        [ sh:datatype xsd:string ;
            sh:description "Runtime activity instance identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/activity_instance_id> ],
        [ sh:datatype xsd:integer ;
            sh:description "Zero-based position of this invocation within its parent agent loop." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/turn_index> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowArtifact> ;
            sh:description "Artifacts consumed by the step run (by-reference; declare full artifacts under ProvenanceBundle.artifacts)." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Incident message." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/incident_message> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/Agent> ;
            sh:description "Agent (assignee, service account, system) that executed the step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:decimal ;
            sh:description "Top-p nucleus sampling parameter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/top_p> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "External URI, engine identifier, or source reference for this entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:integer ;
            sh:description "Total completion / output tokens produced by the invocation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/total_output_tokens> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ParameterValue> ;
            sh:description "Observed input parameter values at the workflow or step boundary (by-reference; declare full values under ProvenanceBundle.parameter_values)." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path schema1:object ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/EvaluationResult> ;
            sh:description "Evaluation results attached to the invocation." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluation_results> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Step runs whose completion preceded and informed this step run (by-reference)." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasInformedBy ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/Environment> ;
            sh:description "Runtime environment in which the run took place." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/environment> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepDefinition> ;
            sh:description "Step definition this run instantiates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path schema1:instrument ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path schema1:name ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AgentLoopRun> ;
            sh:description "Agent loop run that owns this model invocation as one of its turns." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasInformedBy ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowArtifact> ;
            sh:description "Artifacts produced by the step run (by-reference; declare full artifacts under ProvenanceBundle.artifacts)." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path prov:generated ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/ToolCall> ;
            sh:description "Tool / function calls performed by the model during the invocation." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_calls> ],
        [ sh:datatype xsd:decimal ;
            sh:description "Sampling temperature requested for the invocation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/temperature> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution ended (absent for running instances)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path schema1:endTime ],
        [ sh:datatype xsd:decimal ;
            sh:description """Direct provider cost in USD for the invocation, where reported by the
provider or computed locally from billing rates.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/cost_usd> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/PromptMessage> ;
            sh:description "Ordered sequence of prompt messages sent to the model." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/prompt_messages> ],
        [ sh:datatype xsd:integer ;
            sh:description "Maximum tokens the model was permitted to generate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/max_tokens> ],
        [ sh:description "Status of the workflow run or step run." ;
            sh:in ( schema1:PotentialActionStatus schema1:ActiveActionStatus schema1:CompletedActionStatus schema1:FailedActionStatus "CANCELLED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path schema1:actionStatus ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of retries this job has left. Whenever the jobexecutor fails to execute the job, this value is decremented. When it hits zero, the job is supposed to be dead and not retried again (ie a manu..." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/retries> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ParameterValue> ;
            sh:description "Observed output parameter values at the workflow or step boundary (by-reference; declare full values under ProvenanceBundle.parameter_values)." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path schema1:result ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
            sh:description "Parent step run for nested step executions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/parent_step_run> ],
        [ sh:description "Kind of invocation (chat completion, tool use, embedding, etc.)." ;
            sh:in ( "CHAT_COMPLETION" "COMPLETION" "EMBEDDING" "TOOL_USE" "AGENT_LOOP" "RETRIEVAL" "GUARDRAIL" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/invocation_kind> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowRun> ;
            sh:description "Parent workflow run for the step run." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/workflow_run> ],
        [ sh:datatype xsd:integer ;
            sh:description "Exporter-assigned ordering number for deterministic serialization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/sequence_no> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/PromptMessage> ;
            sh:description """Assistant or tool message returned by the model as the response.
Inlined as a single PromptMessage with role ASSISTANT or TOOL.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/response_message> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Timestamp when execution started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path schema1:startTime ],
        [ sh:description """Safety, policy, or guardrail flags raised by the model, provider, or
local guardrail layer during the invocation.""" ;
            sh:in ( "NONE" "POLICY_VIOLATION" "HALLUCINATION_SUSPECTED" "JAILBREAK_ATTEMPT" "PII_LEAK" "PROMPT_INJECTION" "TOXICITY" ) ;
            sh:order 13 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/safety_flags> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiAgent> ;
            sh:description "AI agent that was invoked to produce the step result." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/AiModelInvocation> .

