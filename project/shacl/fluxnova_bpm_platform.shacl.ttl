        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:identifier ],
        [ sh:description "Status of the workflow run or step run." ;
            sh:in ( schema1:PotentialActionStatus schema1:ActiveActionStatus schema1:CompletedActionStatus schema1:FailedActionStatus "CANCELLED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path schema1:actionStatus ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/WorkflowArtifact> ;
            sh:description "Optional artifact reference for large tool outputs." ;
