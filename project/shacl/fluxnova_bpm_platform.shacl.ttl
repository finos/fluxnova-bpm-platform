    rdfs:comment "Concrete execution of a StepDefinition (retrospective provenance)." ;
    sh:closed true ;
    sh:ignoredProperties ( <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/prompt_messages> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/max_tokens> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/tool_calls> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/evaluation_results> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/cost_usd> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/invocation_kind> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/model_invocations> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/temperature> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/total_output_tokens> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/top_p> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/turn_index> rdf:type <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/available_tools> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/total_input_tokens> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/safety_flags> <https://w3id.org/lmodel/fluxnova-bpm-platform/ai-provenance/response_message> ) ;
    sh:property [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ParameterValue> ;
            sh:description "Observed input parameter values at the workflow or step boundary (by-reference; declare full values under ProvenanceBundle.parameter_values)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path schema1:object ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of retries this job has left. Whenever the jobexecutor fails to execute the job, this value is decremented. When it hits zero, the job is supposed to be dead and not retried again (ie a manu..." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/runtime/retries> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path schema1:name ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/ExecutionResource> ;
            sh:description "Resource (pod, container, node, queue) used to execute the step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/execution_resource> ],
        [ sh:class <https://w3id.org/lmodel/fluxnova-bpm-platform/provenance/StepRun> ;
